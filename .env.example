# Template only - real values belong in .env, which is gitignored.
# Copy this file to .env and fill it in:  cp .env.example .env
#
# Never put real secrets in THIS file: it is committed to git.

PORT=3000

# Signs login tokens. Changing it invalidates every issued token, so log out
# of the frontend after setting this for the first time.
JWT_SECRET=replace-with-a-long-random-string

# Optional. Leave empty to run with the in-memory cache only.
# Upstash form: rediss://default:<password>@<host>.upstash.io:6379
REDIS_URL=

# Market data provider.
BINANCE_BASE_URL=https://api.binance.com
BINANCE_STREAM_URL=wss://stream.binance.com:9443/ws
# USDⓈ-M futures, for the TradFi perpetuals (gold, oil, indices). Blocked from
# more regions than spot, US included. Market streams must use /market/ws.
BINANCE_FUTURES_BASE_URL=https://fapi.binance.com
BINANCE_FUTURES_STREAM_URL=wss://fstream.binance.com/market/ws

# Forex, spot metals, oil and index CFDs come from ONE broker feed: cTrader or
# OANDA. FX_PROVIDER picks it (ctrader | oanda); left empty, whichever has
# credentials is used, cTrader first. Without either, those symbols are hidden.
FX_PROVIDER=

# cTrader Open API, e.g. with an IC Markets demo account: prices match
# TradingView's ICMARKETS:XAUUSD. openapi.ctrader.com -> Applications gives the
# client id/secret; its Playground (scope "accounts") gives the tokens.
CTRADER_CLIENT_ID=
CTRADER_CLIENT_SECRET=
CTRADER_ACCESS_TOKEN=
CTRADER_REFRESH_TOKEN=
# demo or live - must match the account the token was issued for.
CTRADER_ENV=demo
# Optional: the ctidTraderAccountId to use; defaults to the token's first demo/live account.
CTRADER_ACCOUNT_ID=
# Refreshed tokens are saved here (gitignored). Paste a new token into .env and it takes over again.
# CTRADER_TOKEN_FILE=.ctrader-tokens.json

# OANDA: forex, spot gold/silver, oil and index CFDs - the same prices as
# TradingView's OANDA:XAUUSD etc. A free practice (demo) account is enough:
# oanda.com -> open a demo account -> Manage API Access -> generate a token.
# Without a token those symbols are simply hidden.
OANDA_API_TOKEN=
# practice (demo account token) or live (real account token).
OANDA_ENV=practice
# Optional: which account's instrument list to use. Defaults to the token's first account.
OANDA_ACCOUNT_ID=
# Optional: B (bid, what TradingView charts), M (mid) or A (ask).
OANDA_PRICE=B
# Optional: live-bar poll interval in ms.
OANDA_POLL_MS=1000
PROVIDER_TIMEOUT_MS=8000

# Live stream. Origins allowed to open a WebSocket, comma-separated. Browsers
# always send Origin on a WS handshake, so an absent one means a non-browser
# client; allow it only for headless testing.
STREAM_ALLOWED_ORIGINS=http://localhost:8000
STREAM_ALLOW_NO_ORIGIN=false
STREAM_TICKET_TTL_SECONDS=30

# WebSocket URL handed to the browser by the frontend's ticket route.
STREAM_PUBLIC_URL=ws://localhost:3000/stream
